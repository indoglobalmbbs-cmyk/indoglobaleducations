VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
VITE_WEBHOOK_URL=your_optional_google_apps_script_webhook_url
VITE_RECAPTCHA_SITE_KEY=your_google_recaptcha_v2_site_key

# Only needed for local Supabase setup scripts. Do not expose these in client code.
SUPABASE_PROJECT_ID=your_supabase_project_ref
SUPABASE_ACCESS_TOKEN=your_supabase_access_token
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_PROJECT_NAME=your_supabase_project_name
RECAPTCHA_SECRET_KEY=your_google_recaptcha_v2_secret_key

# Server-only HubSpot private app credentials and IDs from `pnpm hubspot:setup`.
HUBSPOT_ACCESS_TOKEN=your_private_app_access_token
HUBSPOT_PIPELINE_ID=your_admissions_pipeline_id
HUBSPOT_NEW_LEAD_STAGE_ID=your_new_lead_stage_id
HUBSPOT_OWNER_ID=93911131
HUBSPOT_DEAL_CURRENCY=INR
